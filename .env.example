# Banco (docker compose up -d)
DATABASE_URL="postgresql://adega:adega@localhost:5432/adega?schema=public"

# API
PORT=3000
# Fuso usado para interpretar datas AAAA-MM-DD nos relatórios
FUSO_HORARIO="-03:00"

# JWT: troque por um valor longo e aleatório
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Seed (npm run prisma:seed): ADMIN inicial. Valores de EXEMPLO — troque antes de usar.
SEED_ADMIN_EMAIL="admin@adega.local"
SEED_ADMIN_SENHA="troque-esta-senha"

# ---------------- Assistente de IA ----------------
# false = assistente desligado.
ASSISTENTE_HABILITADO=true
# Provedor: gemini (plano gratuito do Google) ou anthropic (pago)
LLM_PROVIDER=gemini

# Google Gemini: crie a chave em https://aistudio.google.com/apikey
# ATENÇÃO: no plano gratuito o Google pode usar o conteúdo enviado para melhorar os produtos dele.
# Por isso as ferramentas nunca enviam dados pessoais (ver src/modules/assistente/privacidade.ts).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Raciocínio: LOW gasta menos tokens/cota. Vazio = padrão do modelo.
GEMINI_THINKING_LEVEL="LOW"

# Anthropic (opcional, pago)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
ANTHROPIC_EFFORT="low"

# Limites comuns
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=30000
# 0 = não repete após erro (no plano gratuito, repetir após 429 só gasta cota)
LLM_MAX_RETRIES=0
# Máximo de chamadas ao modelo por pergunta (cada chamada conta na cota diária)
ASSISTENTE_MAX_ITERACOES=4
# Se o contexto da conversa passar disso (tokens), pede para iniciar outra conversa
ASSISTENTE_MAX_TOKENS_CONTEXTO=30000
# Rate limit interno do chat, por usuário: N requisições a cada TTL ms
ASSISTENTE_RATE_LIMIT=5
ASSISTENTE_RATE_TTL_MS=60000
